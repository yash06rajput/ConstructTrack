# Origins allowed to call this service directly from a browser (JSON list).
# Server-to-server calls from the Next.js API do not need CORS.
ALLOWED_ORIGINS=["http://localhost:3000"]

# YOLO11 checkpoint (downloaded automatically on first use if missing).
YOLO_MODEL_PATH=models/yolo11n.pt

# Optional shared secret. When set, POST /api/v1/analyze requires the same
# value in an X-API-Key header (the web app sends AI_SERVICE_API_KEY).
SERVICE_API_KEY=
