# ---------------------------------------------------------------------------
# Root environment variable reference for the whole monorepo.
#
# Copy this file to web/.env (Next.js) and ai-service/.env (Python service)
# as needed, filling in real values. NEVER commit a file containing real
# credentials — only this .env.example (with blank/placeholder values)
# should be committed.
# ---------------------------------------------------------------------------

# --- Database (used by web/, via Prisma) ---
# PostgreSQL connection string. Provision via Railway, Render, Supabase, or
# any compatible PostgreSQL host.
DATABASE_URL=

# --- Supabase Storage (used by web/) ---
# Project URL and anon key are safe to expose to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_ and
# never send it to the browser — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Python AI service (used by web/, to call the AI service over HTTP) ---
# Base URL of the deployed (or locally running) FastAPI service, no trailing
# slash, e.g. http://localhost:8000 in dev or your Railway/Render URL in prod.
AI_SERVICE_URL=

# Optional shared secret sent as X-API-Key to the AI service. Must equal the
# AI service's SERVICE_API_KEY. Leave blank for local development.
AI_SERVICE_API_KEY=
